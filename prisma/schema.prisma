generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String     @id @default(uuid())
  email        String     @unique
  nombre       String
  passwordHash String
  preferencias Json       @default("{}")
  templates    Template[]
  reports      Report[]
  createdAt    DateTime   @default(now())
}

model Template {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  nombre    String
  contenido String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id                String   @id @default(uuid())
  usuarioId         String
  usuario           Usuario  @relation(fields: [usuarioId], references: [id])
  sessionId         String?
  templateUsed      String
  originalDictation String
  generatedReport   String
  createdAt         DateTime @default(now())

  // IMPORTANT: never store patient name or any identifying data
}
